model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  password     String
  phone        String?
  address      String?
  profileImage String?
  role         Role
  status       UserStatus @default(ACTIVE)

  technicianProfile TechnicianProfile[]

  bookings Booking[] @relation("CustomerBookings")

  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

